ENV=local
SERVICE=api
AWS_REGION=us-east-1
BOOKS_TABLE=dadhep-books
BOOKS_OWNER_INDEX=owner-created_at-index
PAGES_TABLE=dadhep-pages
CACHE_TABLE=dadhep-cache
UPLOAD_BUCKET=dadhep-uploads
ASSETS_BUCKET=dadhep-assets
SPLIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dadhep-split
PAGE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dadhep-pages
PRIORITY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dadhep-priority
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_APP_CLIENT_ID=example
LOCAL_AUTH_BYPASS=true
LOCAL_USER_ID=local-user
MONLAM_PROVIDER=mock
MONLAM_API_URL=
MONLAM_API_KEY=
MONLAM_API_KEY_HEADER=Authorization
MONLAM_OCR_PATH=/ocr
MONLAM_CLEANUP_PATH=/cleanup
MONLAM_TTS_PATH=/tts
MONLAM_VOICE=default
MONLAM_TIMEOUT_SECONDS=60
PRESIGNED_URL_TTL=900
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=500
PROCESSING_LEASE_SECONDS=840
